# Generate only the refresh translation unit; never modify managed dependencies.
function(esp_lv_present_refresh_hook lvgl_target lvgl_dir)
    # Older LVGL versions use owned canvases and need no lease preparation.
    set(version "")
    foreach(header "include/lvgl/lv_version.h" "lv_version.h" "lvgl.h")
        if(EXISTS "${lvgl_dir}/${header}")
            file(READ "${lvgl_dir}/${header}" contents)
            string(APPEND version "${contents}")
        endif()
    endforeach()
    string(REGEX MATCH "#define[ \t]+LVGL_VERSION_MINOR[ \t]+([0-9]+)" matched "${version}")
    if(NOT matched)
        message(FATAL_ERROR "Cannot identify LVGL version for refresh integration")
    endif()
    if(CMAKE_MATCH_1 LESS 5)
        return()
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(original "${lvgl_dir}/src/core/lv_refr.c")
    set(generator "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/prepare_refresh.py")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/present_lv_refr.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${generator}")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${generator}" "${original}" "${generated}"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot integrate Present refresh preparation: ${error}")
    endif()
    get_target_property(sources ${lvgl_target} SOURCES)
    set(replaced FALSE)
    set(updated)
    foreach(source IN LISTS sources)
        if(source MATCHES "(^|/)src/core/lv_refr\\.c$")
            list(APPEND updated "${generated}")
            set(replaced TRUE)
        else()
            list(APPEND updated "${source}")
        endif()
    endforeach()
    if(NOT replaced)
        message(FATAL_ERROR "Cannot locate LVGL refresh source in ${lvgl_target}")
    endif()
    set_property(TARGET ${lvgl_target} PROPERTY SOURCES "${updated}")
    target_include_directories(${lvgl_target} PRIVATE "${lvgl_dir}/src/core")
endfunction()
