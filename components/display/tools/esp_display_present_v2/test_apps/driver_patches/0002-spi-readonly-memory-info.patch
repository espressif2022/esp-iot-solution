+esp_err_t esp_lcd_panel_io_spi_get_memory_info(esp_lcd_panel_io_handle_t io,
+                                              esp_lcd_panel_io_spi_memory_info_t *info)
+{
+    ESP_RETURN_ON_FALSE(io && info, ESP_ERR_INVALID_ARG, TAG, "invalid argument");
+    if (io->tx_color != panel_io_spi_tx_color) {
+        return ESP_ERR_NOT_SUPPORTED;
+    }
+    const esp_lcd_panel_io_spi_t *spi_panel_io = __containerof(io, esp_lcd_panel_io_spi_t, base);
+    *info = (esp_lcd_panel_io_spi_memory_info_t) {
+        .psram_dma_direct = spi_panel_io->flags.psram_dma_direct,
+    };
+    return ESP_OK;
+}
