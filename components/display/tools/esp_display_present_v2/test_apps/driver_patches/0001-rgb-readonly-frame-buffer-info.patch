+esp_err_t esp_lcd_rgb_panel_get_frame_buffer_info(esp_lcd_panel_handle_t panel,
+                                                 esp_lcd_rgb_panel_frame_buffer_info_t *info)
+{
+    ESP_RETURN_ON_FALSE(panel && info, ESP_ERR_INVALID_ARG, TAG, "invalid argument");
+    esp_rgb_panel_t *rgb_panel = __containerof(panel, esp_rgb_panel_t, base);
+#if RGB_LCD_USE_GDMA_LINK_SWITCH_EVENT
+    const bool link_retirement = true;
+#else
+    const bool link_retirement = false;
+#endif
+    portENTER_CRITICAL(&rgb_panel->spinlock);
+    *info = (esp_lcd_rgb_panel_frame_buffer_info_t) {
+        .width = rgb_panel->timings.h_res,
+        .height = rgb_panel->timings.v_res,
+        .frame_buffer_count = rgb_panel->num_fbs,
+        .frame_buffer_bytes = rgb_panel->fb_size,
+        .bounce_buffer_bytes = rgb_panel->bb_size,
+        .bits_per_pixel = rgb_panel->fb_bits_per_pixel,
+        .continuous_refresh = rgb_panel->flags.stream_mode,
+        .custom_bounce_callback = rgb_panel->on_bounce_empty != NULL,
+        .transformed = rgb_panel->rotate_mask != 0 || rgb_panel->x_gap != 0 || rgb_panel->y_gap != 0,
+        .frame_buffer_retirement = rgb_panel->bb_size != 0 || link_retirement,
+    };
+    portEXIT_CRITICAL(&rgb_panel->spinlock);
+    return ESP_OK;
+}
