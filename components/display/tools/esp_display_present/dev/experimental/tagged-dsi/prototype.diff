+esp_err_t esp_lcd_dpi_panel_select_frame_buffer_tagged(esp_lcd_panel_handle_t panel, const void *frame_buffer, uint64_t generation)
+{
+    if (!panel || !frame_buffer || !generation) {
+        return ESP_ERR_INVALID_ARG;
+    }
+    esp_lcd_dpi_panel_t *dpi = __containerof(panel, esp_lcd_dpi_panel_t, base);
+    uint8_t index = dpi->num_fbs;
+    for (uint8_t i = 0; i < dpi->num_fbs; ++i) {
+        if (dpi->fbs[i] == frame_buffer) {
+            index = i;
+            break;
+        }
+    }
+    if (index == dpi->num_fbs) {
+        return ESP_ERR_INVALID_ARG;
+    }
+    portENTER_CRITICAL(&dpi->present_lock);
+    if (dpi->present_generation) {
+        portEXIT_CRITICAL(&dpi->present_lock);
+        return ESP_ERR_INVALID_STATE;
+    }
+    dpi->cur_fb_index = index;
+    dpi->present_generation = generation;
+    portEXIT_CRITICAL(&dpi->present_lock);
+    return ESP_OK;
+}
