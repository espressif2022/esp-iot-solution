[mapping:esp_display_present_fb_hot_paths]
archive: libesp_display_present.a
entries:
    if ESP_DISPLAY_PRESENT_FB_IRAM = y:
        present_engine (noflash)
        present_backend_fb (noflash)
        present_pixel_engine (noflash)
        present_resources:copy_execute (noflash)
        present_executor (noflash)
        present_executor_cpu (noflash)
